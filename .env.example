# Datenbank (Dev: SQLite, Prod: Postgres-URL)
DATABASE_URL="file:./dev.db"

# Auth.js (NextAuth v5) - zufaelligen Wert via `openssl rand -base64 32` erzeugen.
# WICHTIG: Darf NICHT leer sein! Ein leeres/fehlendes AUTH_SECRET laesst
# Edge-Middleware und Node-Layer unterschiedliche Secrets erzeugen -> die
# gesetzte Session-Cookie wird in der Middleware nicht verifiziert ->
# /members wird dauerhaft zur /login umgeleitet (Redirect-Loop).
# Beispielwert (in echter .env durch eigenen ersetzen):
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Optional: E-Mail-Login via Resend (inaktiv, solange RESEND_API_KEY leer)
RESEND_API_KEY=""
AUTH_EMAIL_FROM="MusicMaster <noreply@musicmaster.app>"

# Ablageort fuer hochgeladene Noten-PDFs (LUH-118). Standard: ./storage/sheets
# Im Container-Deploy auf ein gemountetes Volume zeigen lassen.
SHEET_STORAGE_DIR=""
